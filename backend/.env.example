DATABASE_URL=postgresql+asyncpg://catalog:catalog@localhost:5432/catalog

# Telegram-бот (пусто — бот не запущен)
BOT_TOKEN=
# telegram id админов через запятую
ADMIN_IDS=

# Telegram Mini App
# Публичный HTTPS-URL фронтенда. Telegram не принимает http://localhost —
# без этого значения бот не покажет кнопку открытия каталога.
WEBAPP_URL=http://localhost:3000
# Не проверять подпись initData (только для локальной разработки)
WEBAPP_DEV=false

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=catalog
MINIO_PUBLIC_URL=http://localhost:9000
